{
    "name": "sign-net/whmcs-reseller-plugin",
    "description": "WHMCS provisioning module and reseller addon for Sign.net private labels.",
    "type": "project",
    "keywords": [
        "whmcs",
        "whmcs-module",
        "provisioning",
        "e-signature",
        "white-label",
        "sign.net"
    ],
    "homepage": "https://github.com/sign-net/Sign-Reseller-WHMCS-Plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Sign Pte Ltd",
            "homepage": "https://sign.net"
        }
    ],
    "support": {
        "issues": "https://github.com/sign-net/Sign-Reseller-WHMCS-Plugin/issues",
        "source": "https://github.com/sign-net/Sign-Reseller-WHMCS-Plugin",
        "docs": "https://github.com/sign-net/Sign-Reseller-WHMCS-Plugin/blob/main/docs/INSTALL.md",
        "security": "https://github.com/sign-net/Sign-Reseller-WHMCS-Plugin/security/policy"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "illuminate/database": "^10.48",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload-dev": {
        "psr-4": {
            "SignNet\\ResellerApi\\": "modules/servers/signnet/lib/ResellerApi/",
            "SignNet\\Whmcs\\": "modules/servers/signnet/lib/Whmcs/",
            "SignNet\\Tests\\": "tests/",
            "WHMCS\\": "tests/stubs/WHMCS/"
        },
        "files": [
            "tests/stubs/functions.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs"
    }
}
